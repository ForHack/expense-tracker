# PostgreSQL (контейнер из docker-compose.yml слушает 5433 на хосте)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/expense_tracker?schema=public"

# API (Nest.js)
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
# Секрет для подписи JWT — обязателен, приложение не стартует без него
JWT_SECRET="change-me-in-production"
# Время жизни access-токена (формат ms/vercel: 15m, 1h, 7d)
JWT_EXPIRES_IN="15m"

# Web (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
